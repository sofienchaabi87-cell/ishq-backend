# Configuration du serveur API Express
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:8080

# PostgreSQL connection string
DATABASE_URL=

# Generate a unique secret with at least 32 characters for production.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Used by the Prisma seed to create the first admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
