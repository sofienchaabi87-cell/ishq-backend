# Configuration du serveur API Express
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:8080

# URL de connexion à la base de données PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=PUBLIC
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ishq_db?schema=public"

# Clé secrète pour le hachage et la vérification des JWT (JSON Web Tokens)
JWT_SECRET=ishq_luxe_parfum_secret_key_change_me_in_production_2026
JWT_EXPIRES_IN=7d
